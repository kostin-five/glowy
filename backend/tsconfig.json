{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noUncheckedIndexedAccess": true,
    "useUnknownInCatchVariables": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "app.ts",
    "server.ts",
    "constants/**/*.ts",
    "lib/**/*.ts",
    "middleware/**/*.ts",
    "routes/**/*.ts",
    "scripts/**/*.ts",
    "services/**/*.ts",
    "test/**/*.ts",
    "type-tests/**/*.ts",
    "types/**/*.d.ts",
    "types/**/*.ts",
    "utils/**/*.ts"
  ],
  "exclude": ["dist", "node_modules", "prisma"]
}
