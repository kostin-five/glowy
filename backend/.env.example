PORT=3001
DATABASE_URL=postgresql://user:password@localhost:5432/glowy
DATABASE_TLS_MODE=local
# For remote databases: remove local mode; trusted certificate verification is required.
DATABASE_CA_CERT=
PAYMENTS_ENABLED=false
TRUST_PROXY_HOPS=0
# Optional: required only when manually testing Focus checkout and YooKassa webhook.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=
YOOKASSA_CANCEL_URL=
JWT_SECRET=<your_jwt_secret_key>

# Direct backend providers: DeepSeek primary, GigaChat fallback.
AI_PROVIDER_MODE=direct
AI_PROVIDER_TIMEOUT_MS=30000
DEEPSEEK_API_KEY=<your_deepseek_api_key>
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
GIGACHAT_AUTH_KEY=<your_gigachat_authorization_key>
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2-Max
GIGACHAT_AUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
GIGACHAT_BASE_URL=https://api.giga.chat

# Controlled Focus/Forever analytics beta and optional provider pricing.
AI_COST_DEEPSEEK_INPUT_PER_MILLION_USD=
AI_COST_DEEPSEEK_OUTPUT_PER_MILLION_USD=
AI_COST_GIGACHAT_INPUT_PER_MILLION_USD=
AI_COST_GIGACHAT_OUTPUT_PER_MILLION_USD=

# Temporary rollback mode only. Not required for direct providers.
AI_PROXY_URL=http://localhost:3002
AI_PROXY_SECRET=<your_shared_proxy_secret>

# Telegram Mini App and bot. Backend-only values; never expose them through Vite variables.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_LINK_CODE_SECRET=
TELEGRAM_MINI_APP_URL=https://dev.example.com/telegram
TELEGRAM_MINI_APP_INIT_MAX_AGE_SECONDS=300
TELEGRAM_MINI_APP_SESSION_HOURS=24
TELEGRAM_WORKER_ENABLED=false

# Forever is reserved for a possible future release and remains disabled.
# Existing manually assigned lifetime access continues to use plan=forever.
PAID_FOREVER_ENABLED=false
FOREVER_PRICE_RUB=

CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:4173,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:4173
REGISTRATION_ENABLED=false
