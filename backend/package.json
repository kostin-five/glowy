{
  "name": "backend",
  "version": "2.11.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "sh scripts/build-backend.sh",
    "inventory:check": "sh scripts/check-typescript-inventory.sh",
    "prisma:generate": "prisma generate",
    "serve": "npm run serve:compiled",
    "serve:compiled": "nodemon --watch . --ext ts,json --ignore dist --exec npm run start:compiled",
    "typecheck": "tsc -p tsconfig.json",
    "migrate:deploy": "prisma migrate deploy",
    "start": "node dist/server.js",
    "start:compiled": "npm run build && node dist/server.js",
    "start:prod": "NODE_ENV=production node dist/server.js",
    "test": "npm run inventory:check && npm run build && NODE_ENV=test node --test dist/test/*.test.js dist/services/ai/*.test.js dist/services/billing/*.test.js dist/services/tasks/*.test.js",
    "telegram:webhook:configure": "npm run build && node dist/scripts/telegram-webhook.js configure",
    "telegram:webhook:status": "npm run build && node dist/scripts/telegram-webhook.js status",
    "telegram:webhook:delete": "npm run build && node dist/scripts/telegram-webhook.js delete"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@glowy/contracts": "file:../packages/contracts",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-validator": "^7.3.2",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/supertest": "^7.2.1",
    "nodemon": "^3.1.14",
    "prisma": "^7.10.0",
    "supertest": "^7.2.2",
    "typescript": "~6.0.2"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.3"
  }
}
