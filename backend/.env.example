PORT=3001
DATABASE_URL=postgresql://user:password@localhost:5432/glowy
# Optional: required only when manually testing Focus checkout and YooKassa webhook.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=
YOOKASSA_CANCEL_URL=
JWT_SECRET=<your_jwt_secret_key>

# Direct backend providers: DeepSeek primary, GigaChat fallback.
AI_PROVIDER_MODE=direct
AI_PROVIDER_TIMEOUT_MS=30000
DEEPSEEK_API_KEY=<your_deepseek_api_key>
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
GIGACHAT_AUTH_KEY=<your_gigachat_authorization_key>
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2-Max
GIGACHAT_AUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
GIGACHAT_BASE_URL=https://api.giga.chat

# Temporary rollback mode only. Not required for direct providers.
AI_PROXY_URL=http://localhost:3002
AI_PROXY_SECRET=<your_shared_proxy_secret>

# Founder is free and available through the legacy lifetime activation endpoint.
# Paid Forever is reserved for a possible future release and remains disabled.
PAID_FOREVER_ENABLED=false
FOREVER_PRICE_RUB=

CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:4173
