PORT=3001
DATABASE_URL=postgresql://user:password@localhost:5432/glowy
# Optional: required only when manually testing Focus checkout and YooKassa webhook.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=
YOOKASSA_CANCEL_URL=
JWT_SECRET=<your_jwt_secret_key>

# Backend calls the local ai-proxy, which calls DeepSeek.
AI_PROVIDER=proxy
AI_PROXY_URL=http://localhost:3002
AI_PROXY_SECRET=<your_shared_proxy_secret>
AI_PROXY_TIMEOUT_MS=120000

CORS_ORIGINS=http://localhost:5173,http://localhost:4173
