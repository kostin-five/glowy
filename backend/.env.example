PORT=3001
DATABASE_URL=postgresql://user:password@localhost:5432/glowy
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=
YOOKASSA_CANCEL_URL=
JWT_SECRET=<your_jwt_secret_key>

# Optional: Direct Gemini fallback (if not using ai-proxy)
GEMINI_API_KEY=<your_google_gemini_api_key>
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite
AI_PROVIDER=gemini

AI_PROXY_URL=http://localhost:3002
AI_PROXY_SECRET=<your_shared_proxy_secret>
AI_PROXY_TIMEOUT_MS=120000
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
